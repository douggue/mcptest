# Copy to .env (setup.sh does this for you and fills in the secrets).

# Domain pointing at this server (A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=studio.example.com
# Host shown to OBS as the RTMP server (usually the same domain).
PUBLIC_HOST=studio.example.com

# 64 hex characters. Encrypts stream keys at rest — BACK IT UP; without it saved keys are unreadable.
APP_SECRET=
# Shared between MediaMTX and the dashboard for the live preview.
HLS_CDN_SECRET=
# Required on the first-run screen to create the owner account (stops strangers claiming a fresh server).
SETUP_CODE=

COOKIE_SECURE=true
# Largest single upload, and free space to always keep.
MAX_UPLOAD_GB=20
MIN_FREE_GB=3
# Video conversions run one at a time by default; raise on 8+ core servers.
PREP_CONCURRENCY=1
