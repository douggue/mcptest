# Jgtube settings. Copy this file to ".env" (same folder) and fill in what you need.
# The ".env" file stays on your computer; it is never committed.

# Where Jgtube keeps what it has read. Leave as is unless you want it elsewhere.
JGTUBE_DB_PATH=jgtube.db

# Two-letter country that recommendations are read from.
JGTUBE_REGION=US

# Optional: the port in the address you open (http://127.0.0.1:4317 by default).
# JGTUBE_PORT=4317

# Optional: your YouTube Data API key. Needed for "look for niches by keyword", and
# for the exact date and country of each niche channel's account (read after a
# refresh or a search; about 1 unit of the key's 10,000 daily units per 50 channels).
# Create one in Google Cloud and restrict it to "YouTube Data API v3".
# YOUTUBE_API_KEY=paste-your-key-here

# Optional: read the stored channels again every this many hours while Jgtube is
# running, so that view history builds up (1 to 168; 6 is a good start). Each run
# reads at most 50 channels, and only ones not read in the last 20 hours.
# Leave it out and channels are read again only when you press "Refresh now"
# or run: npm run refresh
# JGTUBE_REFRESH_HOURS=6

# Optional: which AI engines the "Ask AI" buttons may use, main one first, then
# its backups. claude is Claude Code, agy is the Antigravity CLI, codex is the
# Codex CLI. An engine left out is never started. The switch on the page picks
# one of them for a run. To see what is installed: npm run engines
# JGTUBE_ENGINES=claude,agy,codex

# Optional: a model for Antigravity to use. Leave it out to use Antigravity's own
# choice. "agy models" lists the names.
# JGTUBE_AGY_MODEL=Gemini 3.8 Flash

# Optional: your Gemini API key, so that a Gemini model can watch a public
# YouTube video from its link (picture and sound). Create one in Google AI Studio.
# The free tier allows 8 hours of video a day; private videos do not work.
# GEMINI_API_KEY=paste-your-key-here

# Optional: the Gemini model that watches.
# JGTUBE_GEMINI_MODEL=gemini-4-hydrogen

# Optional, and unproven: let Antigravity try to watch a YouTube video from its
# link when it has no copy of the file. Try it first with:
#   npm run engines -- --try --youtube https://www.youtube.com/watch?v=...
# JGTUBE_AGY_YOUTUBE_LINKS=on
