# Jgtube settings. Copy this file to ".env" (same folder) and fill in what you need.
# The ".env" file stays on your computer; it is never committed.

# Where Jgtube keeps what it has read. Leave as is unless you want it elsewhere.
JGTUBE_DB_PATH=jgtube.db

# Two-letter country that recommendations are read from.
JGTUBE_REGION=US

# Optional: your YouTube Data API key. Needed only for "look for niches by keyword".
# Create one in Google Cloud and restrict it to "YouTube Data API v3".
# YOUTUBE_API_KEY=paste-your-key-here
