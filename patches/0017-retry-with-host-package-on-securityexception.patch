+    /**
+     * System services check that the package name an app passes belongs to the calling uid. A clone
+     * runs under the host's uid but passes its own package name, so calls we have no specific hook
+     * for fail with SecurityException ("callerPackageName does not match calling uid", "Caller with
+     * uid N is not com.x"). Each Android release adds such checks to more calls. Rather than crash
+     * the clone, the call is repeated once with the host package in place of the clone's.
+     * Returns null when there is nothing to replace.
+     */
+    private static Object[] withHostPackage(Object[] args) {
+        if (args == null || args.length == 0) return null;
+        String clonePkg;
+        String hostPkg;
+        try {
+            clonePkg = top.niunaijun.blackbox.app.BActivityThread.getAppPackageName();
+            hostPkg = top.niunaijun.blackbox.BlackBoxCore.getHostPkg();
+        } catch (Throwable t) {
+            return null;
+        }
+        if (clonePkg == null || hostPkg == null || clonePkg.equals(hostPkg)) return null;
+        Object[] copy = null;
+        for (int i = 0; i < args.length; i++) {
+            if (clonePkg.equals(args[i])) {
+                if (copy == null) copy = args.clone();
+                copy[i] = hostPkg;
+            }
+        }
+        return copy;
+    }
+
     protected void addMethodHook(MethodHook methodHook) {
         mMethodHookMap.put(methodHook.getMethodName(), methodHook);
     }
