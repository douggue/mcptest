+// Called from BoxCore.cpp (JNI). props = [k0, v0, k1, v1, ...]; needles = substrings of maps lines to drop.
+void VirtualSpoof_configure(const std::vector<std::string> &props, const std::vector<std::string> &needles) {
+    std::lock_guard<std::mutex> guard(g_lock);
+    g_props.clear();
+    for (size_t i = 0; i + 1 < props.size(); i += 2) g_props[props[i]] = props[i + 1];
+    g_maps_needles = needles;
+    if (!g_props.empty()) install_props_hooks_locked();
+    if (!g_maps_needles.empty()) install_open_hooks_locked();
+    LOGD("configured: %zu props, %zu maps filters", g_props.size(), g_maps_needles.size());
 }
