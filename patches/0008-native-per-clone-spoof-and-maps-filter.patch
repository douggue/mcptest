+static void jstringArrayToVector(JNIEnv *env, jobjectArray arr, std::vector<std::string> &out) {
+    if (!arr) return;
+    jsize n = env->GetArrayLength(arr);
+    for (jsize i = 0; i < n; i++) {
+        jstring js = (jstring) env->GetObjectArrayElement(arr, i);
+        if (!js) { out.emplace_back(); continue; }
+        const char *c = env->GetStringUTFChars(js, nullptr);
+        out.emplace_back(c ? c : "");
+        if (c) env->ReleaseStringUTFChars(js, c);
+        env->DeleteLocalRef(js);
+    }
+}
+
+void configureSpoof(JNIEnv *env, jclass clazz, jobjectArray props, jobjectArray mapsFilters) {
+    std::vector<std::string> p, m;
+    jstringArrayToVector(env, props, p);
+    jstringArrayToVector(env, mapsFilters, m);
+    VirtualSpoof_configure(p, m);
+}
