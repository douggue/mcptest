+// The outline of a TLS conversation as it passes: record types and sizes, nothing of the content
+// (which is encrypted anyway). It shows what no other log can: whether the app accepted the
+// server's answer, and how much each side then said. H handshake, C change-cipher, A data, ! alert
+// (followed by its number when it is not encrypted).
+struct TlsWatch {
+    uint8_t hdr[5] = {0, 0, 0, 0, 0};
+    int have = 0;               // bytes of a record header collected so far
+    size_t skip = 0;            // bytes of the current record still to pass
+    int grab = 0;               // bytes of a plain alert still to read
+    uint8_t alert[2] = {0, 0};
+    int records = 0, dataRecords = 0;
+    size_t dataBytes = 0;
+    bool off = false;           // not TLS, or seen enough
+    std::string trace;
+};
+
+void tls_watch(TlsWatch &w, const uint8_t *p, size_t n) {
+    while (n > 0 && !w.off) {
+        if (w.skip) {
+            size_t k = std::min(w.skip, n);
+            for (size_t i = 0; i < k && w.grab > 0; i++) {
+                w.alert[2 - w.grab] = p[i];
+                if (--w.grab == 0) w.trace += "(" + std::to_string(w.alert[1]) + ")";
+            }
+            w.skip -= k; p += k; n -= k;
+            continue;
+        }
+        while (w.have < 5 && n > 0) { w.hdr[w.have++] = *p++; n--; }
+        if (w.have < 5) return;
+        w.have = 0;
+        uint8_t type = w.hdr[0];
+        size_t len = (size_t) w.hdr[3] << 8 | w.hdr[4];
+        if (type < 20 || type > 23 || w.hdr[1] != 3 || len > 16384 + 256) {
+            if (w.records == 0) w.trace = "not TLS";
+            w.off = true;
+            return;
+        }
+        w.records++;
+        if (type == 23) { w.dataRecords++; w.dataBytes += len; }
+        if (w.records <= 10) {
+            if (!w.trace.empty()) w.trace += ' ';
+            w.trace += "C!HA"[type - 20];
+            w.trace += std::to_string(len);
+            if (type == 21 && len == 2) w.grab = 2;
+        } else if (w.records == 11) {
+            w.trace += " ..";
+        }
+        w.skip = len;
+        if (w.records >= 300) w.off = true;
+    }
+}
+
+// The server name in a TLS ClientHello, "" when the bytes are not one or it has none.
+std::string tls_sni(const uint8_t *p, size_t n) {
+    if (n < 5 + 4 + 34 + 1 || p[0] != 22 || p[1] != 3 || p[5] != 1) return "";
+    size_t end = std::min(n, (size_t) 5 + ((size_t) p[3] << 8 | p[4]));
+    size_t i = 5 + 4 + 2 + 32;                              // record and handshake headers, version, random
+    if (i + 1 > end) return "";
+    i += 1 + (size_t) p[i];                                 // session id
+    if (i + 2 > end) return "";
+    i += 2 + ((size_t) p[i] << 8 | p[i + 1]);               // cipher suites
+    if (i + 1 > end) return "";
+    i += 1 + (size_t) p[i];                                 // compression methods
+    if (i + 2 > end) return "";
+    size_t extEnd = std::min(end, i + 2 + ((size_t) p[i] << 8 | p[i + 1]));
+    i += 2;
+    while (i + 4 <= extEnd) {
+        unsigned type = (unsigned) p[i] << 8 | p[i + 1];
+        size_t len = (size_t) p[i + 2] << 8 | p[i + 3];
+        i += 4;
+        if (i + len > extEnd) return "";
+        if (type == 0) {                                    // server_name: list length, type 0, name length, name
+            if (len < 5 || p[i + 2] != 0) return "";
+            size_t nl = (size_t) p[i + 3] << 8 | p[i + 4];
+            if (5 + nl > len || nl == 0 || nl > 253) return "";
+            std::string name((const char *) p + i + 5, nl);
+            for (char ch : name) {
+                bool ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == '_';
+                if (!ok) return "";
+            }
+            return name;
+        }
+        i += len;
+    }
+    return "";
+}
