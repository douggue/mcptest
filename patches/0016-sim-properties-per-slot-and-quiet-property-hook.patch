@@ -45,11 +45,35 @@ static bool lookup_prop(const char *name, std::string &out) {
 
 // ---- __system_property_get / __system_property_read_callback ----------------------------------
 
+// Telephony properties hold one entry per SIM slot, separated by commas ("310260,310260" or
+// ",310260" when only the second slot has a SIM), and the framework reads the entry of the slot
+// the default subscription lives in. A single spoofed value therefore came back EMPTY on phones
+// whose active SIM is not in slot 0. Give the spoofed value the same shape as the real one.
+static std::string shape_like(const char *name, const std::string &spoof, const char *real) {
+    if (strncmp(name, "gsm.", 4) != 0 || !real || !strchr(real, ',')) return spoof;
+    std::string out;
+    const char *p = real;
+    while (true) {
+        const char *comma = strchr(p, ',');
+        size_t len = comma ? (size_t) (comma - p) : strlen(p);
+        if (len > 0) out += spoof;      // slot with a SIM: our value; empty slot stays empty
+        if (!comma) break;
+        out += ',';
+        p = comma + 1;
+    }
+    if (out.find_first_not_of(',') == std::string::npos) return spoof;
+    if (out.size() >= PROP_VALUE_MAX) out.resize(PROP_VALUE_MAX - 1);
+    return out;
+}
+
 static int (*orig_system_property_get)(const char *name, char *value) = nullptr;
 
