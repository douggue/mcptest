+// What the relay did since the last summary line in the log. With it, a report from a phone shows
+// whether the proxy refuses connections, does not answer, or is simply slow; nothing else can,
+// because the app only ever sees "connection reset".
+struct RelayStats {
+    int opened = 0, ready = 0, failed = 0, abandoned = 0, broken = 0;
+    int64_t setupSum = 0, setupMax = 0;
+    size_t down = 0, up = 0;
+    std::string lastFailure;
+    int64_t since = 0;
+    bool any() const { return opened || ready || failed || abandoned || broken || down || up; }
+};
+RelayStats g_relayStats;
+int g_relayOpenNow = 0;
+
+void relay_summary(int64_t now) {
+    RelayStats &t = g_relayStats;
+    if (t.since == 0) t.since = now;
+    if (now - t.since < kRelaySummaryMs) return;
+    if (t.any()) {
+        double sec = (double) (now - t.since) / 1000.0;
+        LOGD("relay, last %.0f s: %d connections asked for, %d ready (proxy took %lld ms on average, %lld ms at most), "
+             "%d failed%s%s, %d given up by the app, %d broken later, %d open now, down %zu KB (%.0f KB/s), up %zu KB",
+             sec, t.opened, t.ready, (long long) (t.ready ? t.setupSum / t.ready : 0), (long long) t.setupMax,
+             t.failed, t.lastFailure.empty() ? "" : ", last reason: ", t.lastFailure.c_str(), t.abandoned, t.broken,
+             g_relayOpenNow, t.down / 1024, (double) (t.down / 1024) / sec, t.up / 1024);
+    }
+    t = RelayStats();
+    t.since = now;
+}
