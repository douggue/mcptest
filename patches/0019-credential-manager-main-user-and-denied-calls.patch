diff --git a/Bcore/src/main/java/top/niunaijun/blackbox/fake/service/ICredentialManagerProxy.java b/Bcore/src/main/java/top/niunaijun/blackbox/fake/service/ICredentialManagerProxy.java
new file mode 100644
index 0000000..33f15ef
--- /dev/null
+++ b/Bcore/src/main/java/top/niunaijun/blackbox/fake/service/ICredentialManagerProxy.java
@@ -0,0 +1,93 @@
+package top.niunaijun.blackbox.fake.service;
+
+import android.os.IBinder;
+
+import java.lang.reflect.Method;
+
+import black.android.os.BRServiceManager;
+import top.niunaijun.blackbox.fake.hook.BinderInvocationStub;
+import top.niunaijun.blackbox.utils.Slog;
+
+/**
+ * Answers the system Credential Manager (saved passwords and passkeys, Android 14+) for clones.
+ *
+ * The real service checks the calling package against the calling uid and several permissions a
+ * clone cannot hold, and throws SecurityException straight into the app: Facebook's login screen
+ * asks for saved credentials as it opens and died with
+ * "uid N does not have android.permission.CREDENTIAL_MANAGER_SET_ALLOWED_PROVIDERS".
+ * A clone also should not be shown the passwords saved for the host. So every request is answered
+ * the way the system answers when nothing is saved: the app's callback gets "no credential", and
+ * the app falls back to its normal login form.
+ */
+public class ICredentialManagerProxy extends BinderInvocationStub {
+    public static final String TAG = "ICredentialManagerProxy";
+    private static final String SERVICE = "credential";
+
+    public ICredentialManagerProxy() {
+        super(BRServiceManager.get().getService(SERVICE));
+    }
+
+    @Override
+    protected Object getWho() {
+        IBinder binder = BRServiceManager.get().getService(SERVICE);
+        if (binder == null) return null;
+        try {
+            return Class.forName("android.credentials.ICredentialManager$Stub")
+                    .getMethod("asInterface", IBinder.class).invoke(null, binder);
+        } catch (Throwable t) {
+            Slog.w(TAG, "ICredentialManager not available: " + t);
+            return null;
+        }
+    }
+
+    @Override
+    protected void inject(Object baseInvocation, Object proxyInvocation) {
+        replaceSystemService(SERVICE);
+    }
+
+    @Override
+    public boolean isBadEnv() {
+        return false;
+    }
+
+    @Override
+    public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
+        String name = method.getName();
+        if (name.equals("asBinder") || method.getDeclaringClass() == Object.class) {
+            return super.invoke(proxy, method, args);
+        }
+        if (name.contains("Create")) {
+            reply(args, "onError", "android.credentials.CreateCredentialException.TYPE_NO_CREATE_OPTIONS", "No provider available");
+        } else if (name.startsWith("clear")) {
+            if (!reply(args, "onSuccess")) reply(args, "onError", "android.credentials.ClearCredentialStateException.TYPE_UNKNOWN", "Not available");
+        } else if (name.contains("Get") || name.startsWith("get")) {
+            reply(args, "onError", "android.credentials.GetCredentialException.TYPE_NO_CREDENTIAL", "No credentials available");
+        }
+        Class<?> type = method.getReturnType();
+        if (type == boolean.class) return false;
+        if (type == int.class) return 0;
+        if (type == long.class) return 0L;
+        return null;   // void, ICancellationSignal (callers accept null), lists
+    }
+
+    /** Calls callback.<method>(strings...) on the first argument that has such a method. */
+    private static boolean reply(Object[] args, String method, String... strings) {
+        if (args == null) return false;
+        Class<?>[] types = new Class<?>[strings.length];
+        for (int i = 0; i < types.length; i++) types[i] = String.class;
+        for (Object arg : args) {
+            if (!(arg instanceof android.os.IInterface)) continue;
+            try {
+                Method m = arg.getClass().getMethod(method, types);
+                m.setAccessible(true);
+                m.invoke(arg, (Object[]) strings);
+                return true;
+            } catch (NoSuchMethodException ignored) {
+            } catch (Throwable t) {
+                Slog.w(TAG, "callback " + method + " failed: " + t);
+                return true;
+            }
+        }
+        return false;
+    }
+}
