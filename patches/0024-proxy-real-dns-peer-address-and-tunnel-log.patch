+int dns_ask(int fd, const std::string &name, std::vector<uint32_t> &ips, uint32_t &ttl, bool &exists) {
+    uint8_t q[2 + 12 + 256 + 4];
+    size_t n = 2;
+    uint16_t id = (uint16_t) (relay_now_ms() ^ (uintptr_t) &q ^ (uint32_t) rand());
+    q[n++] = id >> 8; q[n++] = id & 0xFF;
+    q[n++] = 0x01; q[n++] = 0x00;                       // recursion desired
+    q[n++] = 0; q[n++] = 1; q[n++] = 0; q[n++] = 0; q[n++] = 0; q[n++] = 0; q[n++] = 0; q[n++] = 0;
+    size_t start = 0;
+    while (start <= name.size()) {
+        size_t dot = name.find('.', start);
+        if (dot == std::string::npos) dot = name.size();
+        size_t len = dot - start;
+        if (len == 0 || len > 63) return 0;
+        q[n++] = (uint8_t) len;
+        memcpy(q + n, name.data() + start, len);
+        n += len;
+        start = dot + 1;
+        if (dot == name.size()) break;
+    }
+    q[n++] = 0;
+    q[n++] = 0; q[n++] = 1;                             // type A
+    q[n++] = 0; q[n++] = 1;                             // class IN
+    q[0] = (uint8_t) ((n - 2) >> 8); q[1] = (uint8_t) ((n - 2) & 0xFF);
+    if (!send_all(fd, q, n)) return 0;
+    uint8_t lenb[2];
+    if (!recv_all(fd, lenb, 2)) return 0;
