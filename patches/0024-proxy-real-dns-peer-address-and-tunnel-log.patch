+// A tunnel through the proxy to a public resolver's TCP port 53. *refused: the proxy said no
+// (as opposed to not answering), so asking again soon is pointless.
+int dns_open(const Cfg &c, bool *refused) {
+    for (uint32_t resolver : kDnsResolvers) {
+        int fd = socket(c.proxy.ss_family, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) return -1;
+        timeval tv{kDnsTimeoutSec, 0};
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+        int one = 1;
+        setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+        Dest d;
+        dest_v4(resolver, 53, d);
+        int64_t t0 = relay_now_ms();
+        bool connected = orig_connect(fd, (const sockaddr *) &c.proxy, c.proxyLen) == 0;
+        if (connected && (c.type == 1 ? socks5_handshake(fd, c, d) : http_handshake(fd, c, d))) return fd;
+        close(fd);
+        // A proxy that says no says it at once, and the other resolver may still be allowed.
+        // Silence means it drops this traffic: the other resolver would only double the wait.
+        if (!connected || relay_now_ms() - t0 >= 2000) break;
+        *refused = true;
+    }
+    return -1;
+}
