+// ---- getpeername ----------------------------------------------------------------------------
+// A proxied socket is really connected to the relay (or, for a blocking socket, to the proxy), and
+// that is what getpeername() would say. Code that checks who it is connected to, or that files its
+// connections for reuse under the peer's address, then never finds them again and opens a new
+// connection for every request. So the hook answers with the address the app asked to connect to.
+int (*orig_getpeername)(int, sockaddr *, socklen_t *) = nullptr;
+std::mutex g_peerLock;
+std::unordered_map<std::string, sockaddr_storage> g_peers;   // app socket's own address -> where it asked to go
+
+// Call after connect() on a proxied socket has been started or has succeeded.
+void peer_remember(int fd, const sockaddr *sa) {
+    sockaddr_storage me{};
+    socklen_t ml = sizeof me;
+    if (getsockname(fd, (sockaddr *) &me, &ml) != 0) return;
+    sockaddr_storage asked{};
+    memcpy(&asked, sa, sa->sa_family == AF_INET ? sizeof(sockaddr_in) : sizeof(sockaddr_in6));
+    std::lock_guard<std::mutex> guard(g_peerLock);
+    if (g_peers.size() > 8192) g_peers.clear();   // entries of closed sockets; a port that is reused is overwritten
+    g_peers[relay_key((const sockaddr *) &me)] = asked;
+}
+
+int my_getpeername(int fd, sockaddr *addr, socklen_t *len) {
+    if (!addr || !len) return orig_getpeername(fd, addr, len);
+    socklen_t room = *len;
+    int rc = orig_getpeername(fd, addr, len);
+    if (rc != 0) return rc;
+    Cfg c = snapshot();
+    if (c.type == 0) return rc;
+    sockaddr_storage real{};
+    socklen_t rl = sizeof real;
+    if (orig_getpeername(fd, (sockaddr *) &real, &rl) != 0) return rc;
+    if (real.ss_family != AF_INET && real.ss_family != AF_INET6) return rc;
+    std::string peer = relay_key((const sockaddr *) &real);
+    uint16_t p4 = g_relayPort4.load(), p6 = g_relayPort6.load();
+    bool ours = peer == relay_key((const sockaddr *) &c.proxy) ||
+                (p4 && peer == "127.0.0.1/" + std::to_string(p4)) || (p6 && peer == "::1/" + std::to_string(p6));
+    if (!ours) return rc;
+    sockaddr_storage me{};
+    socklen_t ml = sizeof me;
+    if (getsockname(fd, (sockaddr *) &me, &ml) != 0) return rc;
+    sockaddr_storage asked{};
+    {
+        std::lock_guard<std::mutex> guard(g_peerLock);
+        auto it = g_peers.find(relay_key((const sockaddr *) &me));
+        if (it == g_peers.end()) return rc;
+        asked = it->second;
+    }
+    socklen_t al = asked.ss_family == AF_INET ? sizeof(sockaddr_in) : sizeof(sockaddr_in6);
+    memcpy(addr, &asked, std::min(room, al));
+    *len = al;
+    return 0;
+}
