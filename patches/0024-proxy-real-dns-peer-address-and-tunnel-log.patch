+// ---- Real addresses for names: DNS through the proxy -------------------------------------------
+// A fake address per name keeps lookups off the phone's network, but it hides from the app which
+// names live on the same servers. Apps use exactly that: a browser-style network stack reuses one
+// connection for every name that resolves to the server it is already connected to. TikTok's
+// several dozen names sit on a handful of servers; with a different fake address for each, the
+// app opened a connection per name, ran out of connection slots and kept closing and reopening
+// them, every time through the proxy. So names are resolved for real, through the proxy.
+const int kDnsTimeoutSec = 4;
+const int64_t kDnsOffMs = 10 * 60 * 1000;      // the proxy refused port 53: do not ask again for this long
+const int64_t kDnsRetryMs = 2 * 60 * 1000;     // it did not answer: do not ask again for this long
+const int64_t kDnsIdleMs = 8000;               // a resolver connection unused for longer is not trusted
+const uint32_t kDnsResolvers[] = {0x01010101u, 0x08080808u};   // 1.1.1.1, 8.8.8.8
+const char *kDnsCheckName = "dns-check.clonespace.invalid";    // answered with kFakeBase+1 or +2, see fake_resolve
+
+struct DnsEntry {
+    std::vector<uint32_t> ips;   // network byte order; empty: the name does not exist
+    int64_t expires = 0;
+};
+struct DnsTunnel { int fd; int64_t usedAt; };
