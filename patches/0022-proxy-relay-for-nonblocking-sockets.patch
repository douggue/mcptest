+int relay_listen(int family, uint16_t *port) {
+    int fd = socket(family, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (fd < 0) return -1;
+    sockaddr_storage ss{};
+    socklen_t len;
+    if (family == AF_INET6) {
+        int one = 1;
+        setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &one, sizeof one);
+        sockaddr_in6 *s = (sockaddr_in6 *) &ss;
+        s->sin6_family = AF_INET6;
+        s->sin6_addr = in6addr_loopback;
+        len = sizeof *s;
+    } else {
+        sockaddr_in *s = (sockaddr_in *) &ss;
+        s->sin_family = AF_INET;
+        s->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        len = sizeof *s;
+    }
+    // Loopback only, port chosen by the system.
+    if (bind(fd, (const sockaddr *) &ss, len) != 0 || listen(fd, 512) != 0 ||
+        getsockname(fd, (sockaddr *) &ss, &len) != 0) {
+        close(fd);
+        return -1;
+    }
+    *port = ntohs(family == AF_INET6 ? ((sockaddr_in6 *) &ss)->sin6_port : ((sockaddr_in *) &ss)->sin_port);
+    return fd;
+}
+
+// g_relayLock held. Starts the relay on first use.
+bool relay_start_locked() {
+    if (g_relayState != 0) return g_relayState > 0;
+    g_relayState = -1;
+    g_relayEp = epoll_create1(EPOLL_CLOEXEC);
+    if (g_relayEp < 0) return false;
+    g_relayL4 = relay_listen(AF_INET, &g_relayPort4);
+    g_relayL6 = relay_listen(AF_INET6, &g_relayPort6);
+    if (g_relayL4 < 0 && g_relayL6 < 0) return false;
+    epoll_event ev{};
+    ev.events = EPOLLIN;
+    if (g_relayL4 >= 0) { ev.data.u64 = kRelayTagL4; epoll_ctl(g_relayEp, EPOLL_CTL_ADD, g_relayL4, &ev); }
+    if (g_relayL6 >= 0) { ev.data.u64 = kRelayTagL6; epoll_ctl(g_relayEp, EPOLL_CTL_ADD, g_relayL6, &ev); }
+    // The app's signal handlers must not run on this thread; crash signals stay as they are.
+    sigset_t all, old;
+    sigfillset(&all);
+    for (int s : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT, SIGTRAP}) sigdelset(&all, s);
+    pthread_sigmask(SIG_SETMASK, &all, &old);
+    pthread_t t;
+    int rc = pthread_create(&t, nullptr, relay_main, nullptr);
+    pthread_sigmask(SIG_SETMASK, &old, nullptr);
+    if (rc != 0) return false;
+    pthread_detach(t);
+    g_relayState = 1;
+    LOGD("relay started");
+    return true;
+}
