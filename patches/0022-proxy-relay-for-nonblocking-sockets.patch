+// connect() for a non-blocking socket: hands the connection to the relay and returns at once.
+// -2: the relay is not available, do the handshake in place.
+int relay_connect(int fd, const sockaddr *sa, const Cfg &c) {
+    Dest d;
+    if (!make_dest(sa, d)) { errno = ENETUNREACH; return -1; }
+    if (c.type == 1 && !socks5_fits(c, d)) { errno = ECONNREFUSED; return -1; }
+    int domain = AF_INET;
+    socklen_t dl = sizeof domain;
+    getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &dl);
+    // Held across the connect, so the relay cannot look the connection up before it is registered.
+    std::lock_guard<std::mutex> guard(g_relayLock);
+    if (!relay_start_locked()) return -2;
+    sockaddr_storage to{};
+    socklen_t toLen;
+    if (domain == AF_INET6) {
+        sockaddr_in6 *s = (sockaddr_in6 *) &to;
+        s->sin6_family = AF_INET6;
+        if (g_relayL6 >= 0) {
+            s->sin6_addr = in6addr_loopback;
+            s->sin6_port = htons(g_relayPort6);
+        } else {    // no IPv6 loopback: reach the IPv4 listener through a v4-mapped address
+            s->sin6_addr.s6_addr[10] = 0xFF; s->sin6_addr.s6_addr[11] = 0xFF;
+            s->sin6_addr.s6_addr[12] = 127; s->sin6_addr.s6_addr[15] = 1;
+            s->sin6_port = htons(g_relayPort4);
+        }
+        toLen = sizeof *s;
+    } else {
+        if (g_relayL4 < 0) return -2;
+        sockaddr_in *s = (sockaddr_in *) &to;
+        s->sin_family = AF_INET;
+        s->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        s->sin_port = htons(g_relayPort4);
+        toLen = sizeof *s;
+    }
+    // A second connect() on the same socket (some apps poll for completion that way) must not
+    // register the connection again.
+    sockaddr_storage peer{};
+    socklen_t pl = sizeof peer;
+    bool again = getpeername(fd, (sockaddr *) &peer, &pl) == 0;
+    int rc = orig_connect(fd, (const sockaddr *) &to, toLen);
+    int err = errno;
+    if (!again && (rc == 0 || err == EINPROGRESS)) {
+        sockaddr_storage me{};
+        socklen_t ml = sizeof me;
+        if (getsockname(fd, (sockaddr *) &me, &ml) == 0) {
+            int64_t now = relay_now_ms();
+            if (g_relayPending.size() > 256) {   // announced but never arrived (the app closed first)
+                for (auto it = g_relayPending.begin(); it != g_relayPending.end();) {
+                    if (now - it->second.at > kRelayPendingMs) it = g_relayPending.erase(it); else ++it;
+                }
+            }
+            RelayPending &p = g_relayPending[relay_key((const sockaddr *) &me)];
+            p.dest = d;
+            p.cfg = c;
+            p.at = now;
+        }
+    }
+    errno = err;
+    return rc;
+}
