+    /**
+     * Every component must point at the SAME ApplicationInfo object as the package. The framework
+     * writes an ApplicationInfo into a parcel once and refers back to it for each further use of
+     * that object ("squashing"). With a separate copy per component, an app with a thousand
+     * activities (Facebook) produced a 6 MB reply, far over the 1 MB binder limit, so the call
+     * failed and the app was handed a PackageInfo with no APK path.
+     */
+    private static void shareApplicationInfo(PackageInfo pi) {
+        ApplicationInfo shared = pi.applicationInfo;
+        if (shared == null) return;
+        if (pi.activities != null) for (ActivityInfo c : pi.activities) if (c != null) c.applicationInfo = shared;
+        if (pi.receivers != null) for (ActivityInfo c : pi.receivers) if (c != null) c.applicationInfo = shared;
+        if (pi.services != null) for (ServiceInfo c : pi.services) if (c != null) c.applicationInfo = shared;
+        if (pi.providers != null) for (ProviderInfo c : pi.providers) if (c != null) c.applicationInfo = shared;
+    }
