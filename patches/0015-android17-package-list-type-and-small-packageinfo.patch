+	public static Object createFor(Method method, Object who, Object[] args, List<?> list) {
+		Class<?> type = method == null ? Object.class : method.getReturnType();
+		Class<?> slice = BRParceledListSlice.getRealClass();
+		if (type == Object.class || slice == null || type.isAssignableFrom(slice)) {
+			return create(list);
+		}
+		if (type.isAssignableFrom(ArrayList.class)) {
+			return new ArrayList<Object>(list);
+		}
+		// 1. A constructor that takes the list.
+		for (Constructor<?> c : type.getDeclaredConstructors()) {
+			Class<?>[] p = c.getParameterTypes();
+			if (p.length == 1 && p[0].isAssignableFrom(ArrayList.class)) {
+				try {
+					c.setAccessible(true);
+					return c.newInstance(new ArrayList<Object>(list));
+				} catch (Throwable ignored) {
+				}
+			}
+		}
+		// 2. An empty instance, filled in.
+		try {
+			Constructor<?> c = type.getDeclaredConstructor();
+			c.setAccessible(true);
+			Object empty = c.newInstance();
+			if (replaceList(empty, list)) return empty;
+		} catch (Throwable ignored) {
+		}
+		// 3. The system's own answer, with its content replaced by ours.
+		try {
+			Object real = method.invoke(who, args);
+			if (real != null && replaceList(real, list)) return real;
+		} catch (Throwable ignored) {
+		}
+		top.niunaijun.blackbox.utils.Slog.w("ParceledListSliceCompat", "cannot build " + type.getName() + " for " + method.getName());
+		return create(list);
+	}
