+package top.niunaijun.blackbox.fake.spoof;
+
+import android.app.Notification;
+import android.os.Bundle;
+
+/**
+ * Per-clone notification label. The host sets it in the clone process; every notification the clone
+ * posts then carries it as sub text, so users can tell accounts apart in the shade. Null = unchanged.
+ */
+public final class NotificationLabel {
+    private static volatile String sLabel;
+
+    private NotificationLabel() {
+    }
+
+    public static void set(String label) {
+        sLabel = label == null || label.isEmpty() ? null : label;
+    }
+
+    public static void apply(Notification notification) {
+        String label = sLabel;
+        if (label == null || notification == null) return;
+        try {
+            if (notification.extras == null) notification.extras = new Bundle();
+            notification.extras.putCharSequence(Notification.EXTRA_SUB_TEXT, label);
+        } catch (Throwable ignored) {
+        }
+    }
+}
