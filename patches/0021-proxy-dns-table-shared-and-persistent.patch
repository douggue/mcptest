+        table_read_new_locked(fd);
+        it = g_hostToIdx.find(host);
+        if (it != g_hostToIdx.end()) { flock(fd, LOCK_UN); close(fd); return it->second; }
+    }
+    uint32_t idx = kFirstIdx + (uint32_t) g_idxToHost.size();
