+// Indices start in the upper half (198.19.x.x) so addresses cached by builds that used a
+// per-process table (198.18.0.x) match nothing and are simply looked up again.
+const uint32_t kFirstIdx = 0x10000u;
+const uint32_t kLastIdx = 0x1FFFEu;
+std::string g_tablePath;       // empty: in-memory only
+off_t g_tableOffset = 0;       // how much of the file this process has read
+std::string g_tableRemainder;  // an incomplete last line, kept until the rest arrives
+
+// g_lock held. Reads the lines other processes (or earlier runs) appended since the last call.
+void table_read_new_locked(int fd) {
+    struct stat st{};
+    if (fstat(fd, &st) != 0) return;
+    if (st.st_size < g_tableOffset) {   // file was reset by another process
+        g_idxToHost.clear(); g_hostToIdx.clear(); g_tableOffset = 0; g_tableRemainder.clear();
+    }
+    if (st.st_size == g_tableOffset) return;
+    std::string data = g_tableRemainder;
+    char buf[4096];
+    off_t pos = g_tableOffset;
+    while (pos < st.st_size) {
+        ssize_t n = pread(fd, buf, sizeof buf, pos);
+        if (n <= 0) break;
+        data.append(buf, (size_t) n);
+        pos += n;
+    }
+    g_tableOffset = pos;
+    size_t start = 0;
+    while (true) {
+        size_t nl = data.find('\n', start);
+        if (nl == std::string::npos) break;
+        size_t sp = data.find(' ', start);
+        if (sp != std::string::npos && sp < nl) {
+            uint32_t idx = (uint32_t) strtoul(data.substr(start, sp - start).c_str(), nullptr, 10);
+            std::string host = data.substr(sp + 1, nl - sp - 1);
+            if (idx >= kFirstIdx && idx <= kLastIdx && !host.empty()) {
+                g_idxToHost[idx] = host;
+                g_hostToIdx[host] = idx;
+            }
+        }
+        start = nl + 1;
