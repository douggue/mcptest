+}
+
+// Returns the index for host, assigning one if needed; 0 when the name cannot be stored.
+uint32_t table_index_for(const char *node) {
+    std::string host(node);
+    if (host.empty() || host.size() > 255 || host.find_first_of(" \n\r\t") != std::string::npos) return 0;
