{
  "name": "jgtube",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps && prettier --check \"packages/**/*.ts\" \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/**/*.ts\" \"apps/**/*.{ts,tsx}\"",
    "test": "vitest run --coverage",
    "jgtube": "tsx packages/core/src/cli.ts",
    "refresh": "tsx packages/core/src/cli.ts refresh",
    "api": "tsx packages/server/src/main.ts",
    "mcp": "tsx packages/mcp/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "npm run build && npm run api"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
