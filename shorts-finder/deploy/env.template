# Shorts finder settings on the server. This file is /etc/shorts-finder/env.
# Only root can read it. Edit it with:   sudo nano /etc/shorts-finder/env
# then restart the service:              sudo systemctl restart shorts-finder
#
# Write each setting as NAME=value, with no spaces around "=" and no quotes.

# Required: your YouTube Data API key (replace CHANGE_ME).
YOUTUBE_API_KEY=CHANGE_ME

# Telegram alerts: the token @BotFather gave you, and the number of your chat
# with the bot. Replace both CHANGE_ME, or leave both empty to run without alerts.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# Where the store is kept. Leave as it is: the backups expect it here.
SHORTS_DB_PATH=/var/lib/shorts-finder/shorts-finder.db

# Countries to search in. Every extra country multiplies the searches.
SHORTS_REGIONS=US,GB,CA,AU
SHORTS_LANGUAGE=en

# The key's daily allowance in units. 10000 is what Google gives a new key.
SHORTS_DAILY_UNITS=10000

# What 1,000 Shorts views are taken to be worth, in US dollars, low and high.
SHORTS_RATE_LOW=0.10
SHORTS_RATE_HIGH=0.50

# The most findings sent one by one in a day; the rest go in the daily summary.
SHORTS_MAX_ALERTS_PER_DAY=10

# The hour (0 to 23) the daily summary and the "still running" line go out,
# and the time zone that hour is in, such as Europe/London or America/Toronto.
SHORTS_DIGEST_HOUR=18
SHORTS_TIMEZONE=UTC

# Which channels are followed for their new uploads (through their public
# feeds, at no cost in units): a channel with at most this many subscribers,
# or an account younger than this many days. Both are starting values, to be
# revisited once real readings show where "small" and "new" sit.
SHORTS_FOLLOW_MAX_SUBSCRIBERS=100000
SHORTS_FOLLOW_MAX_ACCOUNT_AGE_DAYS=180
