# Shorts finder settings. Copy this file to ".env" (same folder) and fill it in.
# The ".env" file stays on the computer it runs on; it is never committed.

# Where Shorts finder keeps what it has read. Leave as is unless you want it elsewhere.
# A name without a folder in front is kept in this project's folder.
SHORTS_DB_PATH=shorts-finder.db

# Required: your YouTube Data API key. Create one in Google Cloud and restrict it
# to "YouTube Data API v3" (and, on a server, to that server's address).
YOUTUBE_API_KEY=paste-your-key-here

# Countries to search in: two-letter codes separated by commas. Every extra
# country multiplies the number of searches, and a search costs 100 units.
SHORTS_REGIONS=US,GB,CA,AU

# The language searches lean towards (two letters, such as en or es).
SHORTS_LANGUAGE=en

# The key's daily allowance in units. 10000 is what Google gives a new key.
# It is split 60% searches, 20% readings, 10% channels, 10% kept back.
SHORTS_DAILY_UNITS=10000

# What 1,000 Shorts views are taken to be worth, in US dollars, low and high.
# Used only for the earnings range shown with a finding.
SHORTS_RATE_LOW=0.10
SHORTS_RATE_HIGH=0.50

# Optional: Telegram alerts. Set both or neither; with neither, alerts are off
# and findings are only kept in the store. The token comes from @BotFather;
# the chat id is the number of your chat with the bot (see deploy/README.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The most findings sent one by one in a day. The rest go in the daily summary.
SHORTS_MAX_ALERTS_PER_DAY=10

# The hour (0 to 23) from which the daily summary and the "still running" line
# are sent, and the time zone that hour and the day are counted in.
SHORTS_DIGEST_HOUR=18
SHORTS_TIMEZONE=UTC

# Which channels are followed for their new uploads (through their public
# feeds, at no cost in units): a channel with at most this many subscribers,
# or an account younger than this many days. Both are starting values, to be
# revisited once real readings show where "small" and "new" sit.
SHORTS_FOLLOW_MAX_SUBSCRIBERS=100000
SHORTS_FOLLOW_MAX_ACCOUNT_AGE_DAYS=180
