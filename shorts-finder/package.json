{
  "name": "shorts-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "subjects": "node --env-file-if-exists=.env --import tsx src/cli.ts subjects",
    "status": "node --env-file-if-exists=.env --import tsx src/cli.ts status",
    "report": "node --env-file-if-exists=.env --import tsx src/cli.ts report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,js,json}\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,js,json}\"",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
